DATABASE_URL=postgresql+psycopg://researchpilot:local-development@localhost:5432/researchpilot

# Optional; increases the OpenAlex daily allowance. Keep this key on the server.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Optional Scopus source. Requires an Elsevier developer key and suitable API entitlement.
# Institutional access is usually tied to your institution's network or VPN.
# openalex, scopus, or both: openalex,scopus
SCHOLARLY_PROVIDER=openalex
ELSEVIER_API_KEY=

# Required for literature search from Phase 4 on: embeddings power clustering, and
# from Phase 5 a chat model (gpt-4o-mini) names each cluster.
# Keep this key on the server. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional; point at an OpenAI-compatible endpoint instead of the default.
OPENAI_BASE_URL=
